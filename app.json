{
  "expo": {
    "name": "Namaz Akışı",
    "slug": "namazakisi",
    "version": "0.70.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "namazakisi",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.furkanisikay.namazakisi",
      "infoPlist": {
        "UIDesignRequiresCompatibility": true,
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemType": "com.furkanisikay.namazakisi.kildim",
            "UIApplicationShortcutItemTitle": "Vakti kıldım",
            "UIApplicationShortcutItemIconSymbolName": "checkmark.circle"
          },
          {
            "UIApplicationShortcutItemType": "com.furkanisikay.namazakisi.kible",
            "UIApplicationShortcutItemTitle": "Kıble",
            "UIApplicationShortcutItemIconSymbolName": "safari"
          }
        ],
        "UIBackgroundModes": [
          "fetch"
        ],
        "NSLocalNetworkUsageDescription": "Evinizdeki televizyona vakitlerinizi ve kıldığınız namazları aktarmak için yerel ağınızdaki TV'ye bağlanılır. Veri şifreli ve yalnız iki cihaz arasında gider.",
        "NSBonjourServices": [
          "_namazakisi._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.furkanisikay.namazakisi",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#4CAF50"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK"
      ],
      "versionCode": 151
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withPlayStoreDependency",
      "./plugins/withSiriKisayollari",
      "./plugins/withMuhafizAlarmKit",
      [
        "./plugins/withNamazWidget",
        {
          "etkin": true
        }
      ],
      [
        "./plugins/withNamazSaat",
        {
          "etkin": true
        }
      ],
      [
        "./plugins/withIcloudEsitleme",
        {
          "etkin": true
        }
      ],
      [
        "./plugins/withNamazTV",
        {
          "etkin": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kıble yönünü kamera görüntüsü üzerinde göstermek ve televizyondaki eşleştirme kodunu okumak için kameranız kullanılır. Görüntü kaydedilmez ve cihazınızdan çıkmaz.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/bildirim.mp3",
            "./assets/sounds/bildirim_ios.wav",
            "./assets/sounds/alarm_ios.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Namaz vakitlerinin bulunduğunuz yere göre doğru hesaplanması ve Camideyim açıksa camiye girince Namaz modunun açılması için konumunuz kullanılır. Konumunuz cihazınızdan çıkmaz.",
          "locationAlwaysPermission": "Şehir değiştirdiğinizde namaz vakitlerini kendiliğinden güncellemek ve Camideyim açıksa camiye girince Namaz modunu açmak için konumunuz kullanılır. Konumunuz cihazınızdan çıkmaz.",
          "locationWhenInUsePermission": "Namaz vakitlerinin bulunduğunuz yere göre doğru hesaplanması için konumunuz kullanılır. Konumunuz cihazınızdan çıkmaz.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-task-manager",
      "expo-background-fetch",
      "@maplibre/maplibre-react-native",
      [
        "expo-calendar",
        {
          "calendarPermission": "Namaz vakitlerini takviminize eklemek ve siz açarsanız takviminizdeki etkinliklerin bir namaz vaktiyle çakışıp çakışmadığını denetlemek için takvim izni kullanılır. Takvim bilgileriniz cihazınızdan çıkmaz."
        }
      ],
      "expo-mail-composer",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#4CAF50"
        }
      ]
    ],
    "owner": "furkanisikay",
    "extra": {
      "eas": {
        "projectId": "53674e2a-7561-4e11-a548-3c36760daa4f"
      }
    }
  }
}
