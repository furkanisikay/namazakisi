{
  "name": "namazakisi",
  "version": "0.71.0",
  "description": "Free & Open Source Prayer App (Sadaqah Jariyah)",
  "license": "GPL-3.0",
  "main": "index.ts",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >= 26.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "dil:paketle": "node scripts/dil/paketle.js",
    "commit": "cz",
    "postinstall": "patch-package",
    "prepare": "git config core.hooksPath .githooks || true",
    "submit:android": "bash scripts/submit-android.sh",
    "build:android": "bash scripts/build-android.sh",
    "build:android:no-publish": "bash scripts/build-android.sh --no-publish",
    "build:android:closed-testing": "bash scripts/build-android.sh --submit-profile closed-testing"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@maplibre/maplibre-react-native": "~11.5.0",
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "^1.8.0",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@reduxjs/toolkit": "^2.13.0",
    "adhan": "^4.4.6",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-background-fetch": "~58.0.12",
    "expo-blur": "~58.0.5",
    "expo-calendar": "~58.0.6",
    "expo-camera": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-location": "~58.0.20",
    "expo-mail-composer": "~58.0.3",
    "expo-modules-core": "~58.0.30",
    "expo-notifications": "~58.1.8",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.4",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-task-manager": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "fflate": "0.8.3",
    "lottie-react-native": "~7.5.0",
    "nativewind": "^4.2.7",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.0",
    "tailwindcss": "^3.4.19",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.14",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-splash-screen"
        ],
        "buildFromSource": [
          "expo-camera"
        ]
      }
    }
  }
}
