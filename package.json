{
  "name": "namazakisi",
  "version": "0.52.0",
  "description": "Free & Open Source Prayer App (Sadaqah Jariyah)",
  "license": "GPL-3.0",
  "main": "index.ts",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">= 20.19.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "commit": "cz",
    "postinstall": "patch-package",
    "prepare": "git config core.hooksPath .githooks || true",
    "submit:android": "bash scripts/submit-android.sh",
    "build:android": "bash scripts/build-android.sh",
    "build:android:no-publish": "bash scripts/build-android.sh --no-publish",
    "build:android:closed-testing": "bash scripts/build-android.sh --submit-profile closed-testing"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@maplibre/maplibre-react-native": "~11.5.0",
    "@noble/hashes": "^1.8.0",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.21.0",
    "@reduxjs/toolkit": "^2.12.0",
    "adhan": "^4.4.3",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-background-fetch": "~57.0.21",
    "expo-blur": "~57.0.3",
    "expo-calendar": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.21",
    "expo-mail-composer": "~57.0.2",
    "expo-modules-core": "~57.0.22",
    "expo-notifications": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "lottie-react-native": "~7.3.8",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0",
    "tailwindcss": "^3.4.19",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.64.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-splash-screen"
        ]
      }
    }
  }
}
