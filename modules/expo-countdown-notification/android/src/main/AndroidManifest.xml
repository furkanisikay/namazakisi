<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
  <!-- Sesli anons: goAsync penceresinde konusma bitene kadar CPU uyanik kalmali.
       (Uygulama manifestinde zaten tanimli; modul kendi kendine yeterli olsun diye burada da.) -->
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <!-- Yeniden baslatmada anons alarmlarini geri kurmak icin (AnonsYenidenKurucu). -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

  <application>
    <receiver
      android:name="expo.modules.countdownnotification.CountdownReceiver"
      android:exported="false" />
    <!-- Sesli anons alarmini karsilar; FOREGROUND SERVICE YOK (bkz. AnonsZamanlayici). -->
    <receiver
      android:name="expo.modules.countdownnotification.AnonsReceiver"
      android:exported="false" />
    <!-- Cihaz yeniden baslayinca / guncellemede sesli anonslari geri kurar. -->
    <receiver
      android:name="expo.modules.countdownnotification.AnonsYenidenKurucu"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
