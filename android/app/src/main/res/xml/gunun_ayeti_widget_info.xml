<?xml version="1.0" encoding="utf-8"?>
<!--
  Günün ayeti widget'ı (#380): 4×2 başlar; 4×1 şerit, 2×2 (meal ya da hat), 4×2 ve 4×3
  düzenleri boyuttan ve ÖLÇÜMDEN seçilir (`cekirdek/AyetDuzenSecici`, `GununAyetiCizici`).
  Sığmayan düzen "dokunun" kartına iner; meal "…" ile kesilmez.
  updatePeriodMillis=0: güncelleme yalnız planın bir sonraki `baslangicMs`'inde (imsak) tek
  alarmla ve JS yükü yazınca (`GununAyetiGuncelleyici`).
  Yapılandırma ekranı namaz widget'larıyla ORTAK (`WidgetYapilandirmaActivity`): zemin +
  opaklık + kare boyutta meal/hat; vakit seçenekleri bu widget'ta gizlenir.
  Kilit ekranı (keyguard) YOK: kilit ekranında ayet duvar kâğıdıyla gösterilir.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.furkanisikay.namazakisi.widget.WidgetYapilandirmaActivity"
    android:description="@string/widget_ayet_aciklama"
    android:initialLayout="@layout/widget_ayet_onizleme"
    android:minHeight="110dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="110dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/widget_ayet_onizleme"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
