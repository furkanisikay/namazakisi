<?xml version="1.0" encoding="utf-8"?>
<!-- Günün ayeti 4×1 "dokunun" kartı (#380): künye + "sığmıyor" metni + ok. Metin kodda. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ayet_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ayet_zemin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_zemin" />

    <LinearLayout
        android:id="@+id/ayet_icerik"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ayet_dokunun_kunye"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="sans-serif"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ayet_dokunun_metin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:fontFamily="sans-serif"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ayet_dokunun_ok"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ayet_ok" />
    </LinearLayout>
</FrameLayout>
