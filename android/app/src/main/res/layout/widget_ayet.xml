<?xml version="1.0" encoding="utf-8"?>
<!--
  Günün ayeti widget'ı (#380): 2×2, 2×2 hat, 4×2 ve 4×3 düzenlerinin ORTAK iskeleti.
  Hangi parçanın görüneceği, yazı boyutları ve boşluklar KODDA verilir (`GununAyetiCizici`):
  sığma kararı aynı sayılarla ÖLÇÜLDÜĞÜ için ölçüler XML'de değil kodda tek yerde durur.
  Metin de kodda (`setTextViewText`): RemoteViews başlatıcının sürecinde CİHAZ dilinde şişirilir.
  Arapça satır resimdir (Amiri Quran; RemoteViews pakete gömülü font kullanamaz), rengi tint ile.
  Meal ASLA "…" ile kesilmez (maxLines/ellipsize yok); künye tek satır, sonda kesilebilir.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ayet_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ayet_zemin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_zemin" />

    <LinearLayout
        android:id="@+id/ayet_icerik"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ayet_baslik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ayet_yildiz"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ayet_yildiz" />

            <TextView
                android:id="@+id/ayet_etiket"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:fontFamily="sans-serif"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/ayet_tarih"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="sans-serif"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ayet_govde"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ayet_arapca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ayet_meal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:breakStrategy="high_quality"
                android:hyphenationFrequency="none"
                android:fontFamily="sans-serif"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ayet_kunye"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="sans-serif"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
