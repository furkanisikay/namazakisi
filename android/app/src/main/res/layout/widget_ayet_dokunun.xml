<?xml version="1.0" encoding="utf-8"?>
<!--
  Günün ayeti "dokunun" kartı (#380): ayet bu boyuta ÖLÇÜMLE sığmayınca (meal "…" ile
  kesilmez) künye + "Bugünün ayeti bu boyuta sığmıyor. Okumak için dokunun." + "Açın".
  Veri yokken de bu kart çizilir ("Uygulamayı açın"). Metin kodda (`GununAyetiCizici`).
  Erişilebilirlik metni (kökte) ayetin TAMAMIDIR: ekran okuyucu kartta da meali duyar.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ayet_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ayet_zemin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_zemin" />

    <LinearLayout
        android:id="@+id/ayet_icerik"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/ayet_baslik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ayet_yildiz"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ayet_yildiz" />

            <TextView
                android:id="@+id/ayet_etiket"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:fontFamily="sans-serif"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ayet_dokunun_kunye"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:fontFamily="sans-serif"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ayet_dokunun_metin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:fontFamily="sans-serif"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="24dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ayet_dokunun_ok"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ayet_ok" />

            <TextView
                android:id="@+id/ayet_dokunun_acin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
