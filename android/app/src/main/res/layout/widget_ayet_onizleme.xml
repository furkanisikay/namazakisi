<?xml version="1.0" encoding="utf-8"?>
<!--
  Günün ayeti widget'ının SEÇİCİ önizlemesi ve ilk düzeni (previewLayout / initialLayout).
  DİL: buradaki `@string`'ler başlatıcının sürecinde CİHAZ dilinde çözülür (seçicinin dili de
  odur). Gerçek widget'ın her metnini `GununAyetiCizici` UYGULAMA dilinde KODDA yazar; buraya
  çizimde görünecek ayet metni ekleme.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_zemin"
        android:tint="@color/widget_my_zemin" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ayet_yildiz"
                android:tint="@color/widget_my_vurgu" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/widget_ayet_adi"
                android:textColor="@color/widget_my_vurgu"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/widget_ayet_aciklama"
            android:textColor="@color/widget_my_metin"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
