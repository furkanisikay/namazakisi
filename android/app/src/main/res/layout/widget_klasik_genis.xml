<?xml version="1.0" encoding="utf-8"?>
<!--
  Klasik (yeşil) 4×2 widget — Widget 1.0 görünümü (solda geri sayım, sağda günün altı
  vakti, içinde bulunulan vakit koyu bantla). Çizici: `WidgetGuncelleyici.klasikCiz`.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/klasik_genis_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_klasik_zemin"
    android:baselineAligned="false"
    android:padding="8dp">

    <!-- Sol: geri sayım -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical"
        android:gravity="center"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/klasik_genis_vakit_adi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Akşama"
            android:textColor="@color/widget_klasik_metin"
            android:textSize="17sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/klasik_genis_kalan_metin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02:33"
            android:textColor="@color/widget_klasik_vurgu"
            android:textSize="32sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <!-- Kalan süre: sistem çizer (dakikalık alarm YOK). Saat aşınca H:MM:SS olur;
             "2:33:12" sığsın diye yazı örnekten biraz küçük. -->
        <Chronometer
            android:id="@+id/klasik_genis_kalan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="@color/widget_klasik_vurgu"
            android:textSize="24sp"
            android:textStyle="bold"
            android:maxLines="1" />

    </LinearLayout>

    <!-- Sağ: vakit listesi -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/klasik_satir_sabah"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <TextView
                android:id="@+id/klasik_sabah_ad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:text="İmsak"
                android:textColor="@color/widget_klasik_metin_soluk"
                android:textSize="12sp"
                android:maxLines="1" />
            <TextView
                android:id="@+id/klasik_sabah_saat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="05:04"
                android:textColor="@color/widget_klasik_metin_soluk"
                android:textSize="12sp"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/klasik_satir_gunes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <TextView
                android:id="@+id/klasik_gunes_ad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:text="Güneş"
                android:textColor="@color/widget_klasik_metin_soluk"
                android:textSize="12sp"
                android:maxLines="1" />
            <TextView
                android:id="@+id/klasik_gunes_saat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="06:27"
                android:textColor="@color/widget_klasik_metin_soluk"
                android:textSize="12sp"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/klasik_satir_ogle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <TextView
                android:id="@+id/klasik_ogle_ad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:text="Öğle"
                android:textColor="@color/widget_klasik_metin_soluk"
                android:textSize="12sp"
                android:maxLines="1" />
            <TextView
                android:id="@+id/klasik_ogle_saat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="12:59"
                android:textColor="@color/widget_klasik_metin_soluk"
                android:textSize="12sp"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/klasik_satir_ikindi"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <TextView
                android:id="@+id/klasik_ikindi_ad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:text="İkindi"
                android:textColor="@color/widget_klasik_metin_soluk"
                android:textSize="12sp"
                android:maxLines="1" />
            <TextView
                android:id="@+id/klasik_ikindi_saat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="16:32"
                android:textColor="@color/widget_klasik_metin_soluk"
                android:textSize="12sp"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/klasik_satir_aksam"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <TextView
                android:id="@+id/klasik_aksam_ad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:text="Akşam"
                android:textColor="@color/widget_klasik_metin_soluk"
                android:textSize="12sp"
                android:maxLines="1" />
            <TextView
                android:id="@+id/klasik_aksam_saat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="19:21"
                android:textColor="@color/widget_klasik_metin_soluk"
                android:textSize="12sp"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/klasik_satir_yatsi"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <TextView
                android:id="@+id/klasik_yatsi_ad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:text="Yatsı"
                android:textColor="@color/widget_klasik_metin_soluk"
                android:textSize="12sp"
                android:maxLines="1" />
            <TextView
                android:id="@+id/klasik_yatsi_saat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="20:38"
                android:textColor="@color/widget_klasik_metin_soluk"
                android:textSize="12sp"
                android:maxLines="1" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
