<?xml version="1.0" encoding="utf-8"?>
<!-- Widget yapılandırma ekranı (issue #275). Kibar "siz" dili; dokunma hedefleri ≥ 48dp. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/widget_ayar_baslik"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/widget_ayar_zemin"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <RadioGroup
            android:id="@+id/ayar_zemin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/ayar_zemin_material"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/widget_ayar_zemin_material" />

            <RadioButton
                android:id="@+id/ayar_zemin_acik"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/widget_ayar_zemin_acik" />

            <RadioButton
                android:id="@+id/ayar_zemin_koyu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/widget_ayar_zemin_koyu" />

            <RadioButton
                android:id="@+id/ayar_zemin_seffaf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/widget_ayar_zemin_seffaf" />
        </RadioGroup>

        <TextView
            android:id="@+id/ayar_opaklik_baslik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/ayar_opaklik"
            android:text="@string/widget_ayar_opaklik"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <SeekBar
            android:id="@+id/ayar_opaklik"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:max="80" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/widget_ayar_gosterim"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <RadioGroup
            android:id="@+id/ayar_gosterim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/ayar_gosterim_kalan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/widget_ayar_gosterim_kalan" />

            <RadioButton
                android:id="@+id/ayar_gosterim_bitis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/widget_ayar_gosterim_bitis" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_ayar_gosterim_not"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Switch
            android:id="@+id/ayar_sonraki"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/widget_ayar_sonraki"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ayar_vazgec"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/widget_ayar_vazgec" />

            <Button
                android:id="@+id/ayar_kaydet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="@string/widget_ayar_kaydet" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
