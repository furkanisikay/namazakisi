// NamazKisayollari.swift
"${applicationName} sıradaki namaz ne zaman" = "${applicationName} tətbiqində növbəti namaz nə vaxtdır";
"${applicationName} sıradaki namaz" = "${applicationName} növbəti namaz";
"${applicationName} ile sıradaki namazı söyle" = "${applicationName} ilə növbəti namazı de";
"${applicationName} namaz vakti" = "${applicationName} namaz vaxtı";
"${applicationName} şu anki vakti kıldım" = "${applicationName} tətbiqində hazırkı vaxtı qıldım";
"${applicationName} namazımı kıldım" = "${applicationName} tətbiqində namazımı qıldım";
"${applicationName} ile vakti kıldım olarak işaretle" = "${applicationName} ilə vaxtı qıldım kimi qeyd et";
"${applicationName} kıbleyi aç" = "${applicationName} tətbiqində qibləni aç";
"${applicationName} ile kıbleyi göster" = "${applicationName} ilə qibləni göstər";
"${applicationName} günün ayeti görseli" = "${applicationName} günün ayəsi şəkli";
"${applicationName} ile günün ayeti görselini hazırla" = "${applicationName} ilə günün ayəsi şəklini hazırla";
