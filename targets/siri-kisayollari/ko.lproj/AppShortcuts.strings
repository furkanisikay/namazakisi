"${applicationName} namazımı kıldım" = "${applicationName} 예배 드렸어요";
"${applicationName} ile vakti kıldım olarak işaretle" = "${applicationName}에서 현재 예배를 완료로 표시해 줘";
"${applicationName} kıbleyi aç" = "${applicationName}에서 예배 방향 열어 줘";
"${applicationName} ile kıbleyi göster" = "${applicationName}에서 예배 방향 보여 줘";
